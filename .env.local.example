# 填入你拥有的任意一个 Key，系统会自动识别
# 如果同时有多个 Key，用 AI_PROVIDER 显式指定

# Anthropic Claude（使用 claude-sonnet-4-6）
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://your-proxy.com

# OpenAI（使用 gpt-5.2）
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-proxy.com/v1
# OPENAI_MODEL=gpt-5.2          # 中转站模型名可能不同，按需修改

# Google Gemini（使用 gemini-2.5-flash）
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://your-proxy.com  # 设置后自动走 OpenAI 兼容接口（中转站通用）
# GEMINI_MODEL=gemini-2.5-flash           # 中转站模型名可能不同，按需修改

# 可选：显式指定 provider（anthropic / openai / gemini）
# 不填则按上面顺序自动检测
# AI_PROVIDER=anthropic
